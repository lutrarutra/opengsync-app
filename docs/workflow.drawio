    <diagram id="gaps" name="3 · Known gaps">
        <mxGraphModel dx="1358" dy="711" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0" adaptiveColors="none">
            <root>
                <mxCell id="gaps0"/>
                <mxCell id="gaps_flow" parent="gaps0" value="Gaps"/>
                <mxCell id="gapsc1" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Worker promotes experiments that have no run&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;status_updater.py:148-156&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Every minute, any DRAFT / LOADED / SEQUENCING experiment without a SeqRun is set to SEQUENCED; its pools, libraries, requests and projects then cascade. The __find_finished_experiments filter was dropped in commit d9685235 and is now unused.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="20" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc2" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;1&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="30" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc3" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;UI ‘Share data’ never sets Library SHARED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;ShareProjectDataAction.py:123-180&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Only the release API sets SHARED. Requests released through the UI stay DATA_PROCESSING forever and never reach FINISHED.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="460" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc4" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;2&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="470" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc5" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Adding libraries to a lab prep does not set PREPARING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;LibraryPrepAction.py:74&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Libraries stay ACCEPTED. The library Qubit/BA pickers filter on PREPARING, so they come up empty. Removing a library does not revert status either.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="900" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc6" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;3&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="910" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc7" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;rf_scanner overwrites experiment status on every scan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;rf_scanner.py:224-251&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Manual FAILED / CANCELED are reverted while the run folder exists. RUNNING → FINISHED cascades one scan late.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="20" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc8" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;4&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="30" y="202" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc9" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Load flowcell has no status guard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;LoadFlowCell*Action.py&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Re-submitting can move a SEQUENCED / DEMULTIPLEXED experiment back to LOADED.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="460" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc10" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;5&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="470" y="202" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc11" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;QC-only requests have no end state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;StoreSamplesAction.py:110-120&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;QC_COMPLETED is never set; request stays SAMPLES_RECEIVED. QC_PENDING/QC_COMPLETED ids (14/15) also compare as ‘≥ SHARED’.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="900" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc12" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;6&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="910" y="202" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc13" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Accepting a request re-opens its projects&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;core/actions.py:273-276&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;All projects go to PROCESSING, including DELIVERED or ARCHIVED ones.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="20" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc14" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;7&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="30" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc15" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;‘Complete project’ is practically unreachable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;routes/htmx/projects.py:281-307&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Button requires PROCESSING, but the worker has already moved the project to SEQUENCED; release already sets DELIVERED.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="460" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc16" parent="gaps_flow" style="ellipse;html=1;fillColor=#dc2626;strokeColor=none;fontColor=#ffffff;fontSize=11;" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;8&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="22" x="470" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="gapsc17" parent="gaps_flow" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#fca5a5;align=left;verticalAlign=top;spacingLeft=40;spacingTop=10;spacingRight=10;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;PREPARED set in four places with different rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:9px;color:#64748b;&quot;&gt;lab_preps.py:394-400&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Complete prep has no guard and can push a DATA_PROCESSING / FINISHED request back to PREPARED; pooling only if ACCEPTED; worker only from SAMPLES_RECEIVED.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="150" width="420" x="900" y="360" as="geometry"/>
                </mxCell>
