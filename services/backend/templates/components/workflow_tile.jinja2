{% from "components/tooltip.jinja2" import tooltip %}

{# Workflow launcher tile: opens `url` in the fullscreen/xl modal. With `disabled_reason`, renders an inert tile explaining why. #}
{% macro workflow_tile(title, description, url, modal="fullscreen", img=none, bi=none, disabled_reason=none) %}
{% if disabled_reason %}
<div class="workflow-tile disabled" aria-disabled="true" {{ tooltip(disabled_reason, category="warning") }}>
{% else %}
<button type="button" class="workflow-tile"
    data-bs-toggle="modal" data-bs-target="#{{ modal }}-modal"
    hx-get="{{ url }}" hx-target="#{{ modal }}-modal-content" hx-swap="innerHTML">
{% endif %}
    <span class="workflow-tile-icon">
        {% if img %}<img src="{{ url_for('static', filename='images/' ~ img) }}" alt="">{% else %}<i class="bi {{ bi }}"></i>{% endif %}
    </span>
    <span class="workflow-tile-text">
        <span class="workflow-tile-title">{{ title }}</span>
        <span class="workflow-tile-desc">{{ description }}</span>
    </span>
{% if disabled_reason %}
</div>
{% else %}
</button>
{% endif %}
{% endmacro %}
