{% from "components/contextmenu.jinja2" import context_menu %}

{#- right-click on a barcode badge: copy its adapter name or sequences -#}
{% macro index_copy_menu(index) -%}
{%- set actions = [] -%}
{%- if index.name_i7 -%}
{%- set name = index.name_i7 if not index.name_i5 or index.name_i5 == index.name_i7 else index.name_i7 ~ "+" ~ index.name_i5 -%}
{%- set _ = actions.append({"type": "copy", "value": name, "label": "Copy adapter name"}) -%}
{%- endif -%}
{%- if index.sequence_i7 -%}{%- set _ = actions.append({"type": "copy", "value": index.sequence_i7, "label": "Copy i7 sequence"}) -%}{%- endif -%}
{%- if index.sequence_i5 -%}{%- set _ = actions.append({"type": "copy", "value": index.sequence_i5, "label": "Copy i5 sequence"}) -%}{%- endif -%}
{{ context_menu(actions) }}
{%- endmacro %}

{% macro index_type_label(index) %}
<span class="text-muted">{% if notna(index.sequence_i7) and notna(index.sequence_i5) %}DI:{% else %}SI:{% endif %}</span>
{% endmacro %}

{% macro library_index_cell(library) %}
<div class="scroll-container">
    {% if library.index_type in [C.IndexType.DUAL_INDEX, C.IndexType.COMBINATORIAL_DUAL_INDEX] %}
    {% for index in library.indices %}
    {% set badge_color = index_badge_class(index) %}
    {% if index.name_i7 %}
    {% if index.name_i7 == index.name_i5 %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }} >{{ index_type_label(index) }}{{ index.name_i7 }}</span>
    {% else %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index_type_label(index) }}{{ index.name_i7 }}{% if index.name_i5 %}+{{ index.name_i5 }}{% endif %}</span>
    {% endif %}
    {% else %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index_type_label(index) }}{{ index.sequence_i7 }}{% if index.sequence_i5 %}+{{ index.sequence_i5 }}{% endif %}</span>
    {% endif %}
    <span class="badge index-badge index-badge-seq cm-callback {{ badge_color }}" {{ index_copy_menu(index) }} style="display: none;">{{ index.sequence_i7 }}{% if index.sequence_i5 %}+{{ index.sequence_i5 }}{% endif %}</span>
    {% endfor %}
    {% elif library.index_type == C.IndexType.SINGLE_INDEX_I7 %}
    {% for index in library.indices %}
    {% set badge_color = index_badge_class(index) %}
    {% if index.name_i7 %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index_type_label(index) }}{{ index.name_i7 }}</span>
    {% else %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index.sequence_i7 }}</span>
    {% endif %}
    <span class="badge index-badge index-badge-seq cm-callback {{ badge_color }}" {{ index_copy_menu(index) }} style="display: none;">{{ index.sequence_i7 }}</span>
    {% endfor %}
    {% elif library.index_type == C.IndexType.TENX_ATAC_INDEX %}
    {% for index in library.indices %}
    {% set badge_color = index_badge_class(index) %}
    {% if index.name_i7 %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index_type_label(index) }}{{ index.name_i7 }}</span>
    {% else %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index.sequence_i7 }}</span>
    {% endif %}
    <span class="badge index-badge index-badge-seq cm-callback {{ badge_color }}" {{ index_copy_menu(index) }} style="display: none;">{{ index.sequence_i7 }}</span>
    {% endfor %}
    {% else %}
    {% for index in library.indices %}
    {% set badge_color = index_badge_class(index) %}
    {% if index.name_i7 %}
    {% if index.name_i7 == index.name_i5 %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }} >{{ index_type_label(index) }}{{ index.name_i7 }}</span>
    {% else %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index.name_i7 }}{% if index.name_i5 %}+{{ index.name_i5 }}{% endif %}</span>
    {% endif %}
    {% else %}
    <span class="badge index-badge index-badge-name cm-callback {{ badge_color }}" {{ index_copy_menu(index) }}>{{ index.sequence_i7 }}{% if index.sequence_i5 %}+{{ index.sequence_i5 }}{% endif %}</span>
    {% endif %}
    <span class="badge index-badge index-badge-seq cm-callback {{ badge_color }}" {{ index_copy_menu(index) }} style="display: none;">{{ index.sequence_i7 }}{% if index.sequence_i5 %}+{{ index.sequence_i5 }}{% endif %}</span>
    {% endfor %}
    {% endif %}
</div>
{% endmacro %}