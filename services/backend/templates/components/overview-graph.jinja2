{# Overview graph (static/js/overview-graph.js) in a full-screen popup: the button goes on the page title line,
   the popup outside the page header (its stacking context would hide the popup behind the backdrop).
   `views`: the URL of the graph, or [(label, url[, hover title]), …] for several graphs with a switch in the
   popup's header (scrolls when there are many; the first is shown first; each loads the first time it is shown). #}

{% macro overview_button(id) -%}
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#{{ id }}"
    title="Samples, libraries, pools and their statuses as a diagram">
    <i class="bi bi-diagram-3"></i> Overview
</button>
{%- endmacro %}

{% macro overview_modal(id, views, title) -%}
{% set views = [("Overview", views)] if views is string else views %}
<div class="modal fade overview-modal" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}-title" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title text-nowrap" id="{{ id }}-title"><i class="bi bi-diagram-3"></i> {{ title }}</h5>
                {% if views | length > 1 %}
                <div class="ms-3 me-2" style="min-width: 0; overflow-x: auto;">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Overview">
                        {% for view in views %}
                        <input type="radio" class="btn-check" name="{{ id }}-view" id="{{ id }}-view-{{ loop.index }}"
                            value="{{ loop.index }}" autocomplete="off" {% if loop.first %}checked{% endif %}>
                        <label class="btn btn-outline-primary text-nowrap" for="{{ id }}-view-{{ loop.index }}"
                            {% if view | length > 2 %}title="{{ view[2] }}"{% endif %}>{{ view[0] }}</label>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column p-2" style="overflow: hidden;">
                {% for view in views %}
                <div class="overview-graph{% if not loop.first %} d-none{% endif %}" data-view="{{ loop.index }}" data-url="{{ view[1] }}"
                    style="position: relative; flex: 1; min-height: 0;">
                    <div class="spinner-border cemm-blue" role="status"><span class="visually-hidden">Loading...</span></div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
<script type="module">
    import { mountOnOpen } from "{{ url_for('static', filename='js/overview-graph.js') }}";
    mountOnOpen(document.getElementById("{{ id }}"));
</script>
{%- endmacro %}
