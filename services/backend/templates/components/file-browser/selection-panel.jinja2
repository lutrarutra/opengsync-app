{#
  The panel of paths picked in the insider browser (static/js/path-selection.js); the caller block is its footer.
  persist: keep the selection in localStorage (insider browser); the Data tab picker starts empty every time.
  associate_url / share_url: what the footer's Associate / Share buttons open.
  allow_roots: whether a share root (<root> itself) can be selected; not when adding data paths.
  initial_paths / owner_label: the Data tab picker's linked paths, ticked at the start; unticking one unlinks it.
#}
{% macro selection_panel(max_paths, persist=true, associate_url=none, share_url=none, allow_roots=true, initial_paths=none, owner_label=none) %}
<section class="path-selection-panel" id="path-selection-panel" aria-label="Selected paths" hidden
         data-max-paths="{{ max_paths }}"
         {% if not persist %}data-persist="false"{% endif %}
         {% if not allow_roots %}data-allow-roots="false"{% endif %}
         {% if initial_paths %}data-initial-paths='{{ initial_paths | tojson }}'{% endif %}
         {% if owner_label %}data-owner-label="{{ owner_label }}"{% endif %}
         {% if associate_url %}data-associate-url="{{ associate_url }}"{% endif %}
         {% if share_url %}data-share-url="{{ share_url }}"{% endif %}>
    <div class="path-selection-header">
        <h2 class="path-selection-title path-selection-count"></h2>
        <button type="button" class="path-selection-icon-button path-selection-clear" title="Clear selection" aria-label="Clear selection">
            <i class="bi bi-x-circle" aria-hidden="true"></i>
        </button>
        <button type="button" class="path-selection-icon-button path-selection-collapse" title="Collapse" aria-label="Collapse" aria-expanded="true">
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </button>
    </div>
    <ul class="path-selection-list"></ul>
    {{ caller() }}
</section>
<script src="{{ url_for('static', filename='js/path-selection.js') }}"></script>
{% endmacro %}
