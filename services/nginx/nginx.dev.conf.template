# Dev only: the parts of nginx.template.conf that share downloads need, to try zip downloads (mod_zip)
# locally. Started with `make dev-nginx`; the image's
# entrypoint fills in ${OPENGSYNC_PORT} (only variables set in the environment are replaced).
upstream opengsync-app {
    server opengsync-app:${OPENGSYNC_PORT};
}

server {
    listen 80;
    client_max_body_size 20M;

    location / {
        proxy_pass http://opengsync-app/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /;
        proxy_set_header X-Archive-Support zip;

        proxy_set_header Depth $http_depth;
        proxy_set_header Destination $http_destination;
        proxy_set_header Overwrite $http_overwrite;
        proxy_set_header If $http_if;
        proxy_set_header Lock-Token $http_lock_token;
        proxy_set_header Timeout $http_timeout;

        proxy_redirect off;
    }

    location /api/shares/zip/ {
        proxy_pass http://opengsync-app/api/shares/zip/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /;
        proxy_set_header X-Archive-Support zip;
        # mod_zip needs the file list to answer HEAD with the zip's Content-Length
        proxy_method GET;
        proxy_read_timeout 300s;
        proxy_redirect off;
    }

    # /static is served by the dev app from its bind mounts, so it isn't aliased here

    location /nginx-share/ {
        internal;
        alias /share/;
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
    }

}
