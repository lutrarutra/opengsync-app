[Unit]
Description=Weekly pgBackRest backup (and monthly snapshot) for opengsync Postgres

[Timer]
# Sunday night, off-peak. The weekly full bounds restore time (replay of at most
# a week of WAL) and is what lets old WAL be expired; the first run of each month
# also takes the monthly snapshot. See pgbackrest-backup.sh and pgbackrest.conf.
OnCalendar=Sun *-*-* 03:30:00
# Run on boot if the machine was off at the scheduled time.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
