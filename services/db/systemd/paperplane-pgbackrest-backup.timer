[Unit]
Description=Daily pgBackRest backup for opengsync Postgres

[Timer]
# Off-peak. The exact time matters little; what matters is that it runs daily so
# the differential chain never grows long.
OnCalendar=*-*-* 03:30:00
# Run on boot if the machine was off at the scheduled time.
Persistent=true
# Spread load instead of a thundering herd at exactly 03:30.
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
